    { "t": 6.0,  "id": "push_in",     "until": 7.0, "desc": "금 간 곳으로 빨라지며 밀고 들어감(스피드 램프)" },
    { "t": 7.0,  "id": "crack_open",  "desc": "금이 갈라지며 로봇팔 마디로 바뀜(매치 컷). 유리 같은 갈라짐 + 낮은 타격" },
    { "t": 7.1,  "id": "servo_1",     "until": 8.4, "desc": "팔이 펴지며 움직임(서보 소리, 음높이 오름)" },
