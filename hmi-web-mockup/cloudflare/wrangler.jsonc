{
  // 밖에서 여는 HMI — 화면 파일(site/, make-server-bundle.py --dir로 만듦)은 Cloudflare가 내주고, /ws/hmi만 worker.js가 터널로 넘긴다.
  // 설정 순서와 구조는 docs/cloudflare.md. 서비스 토큰(CF_ACCESS_CLIENT_ID · CF_ACCESS_CLIENT_SECRET)은 wrangler secret put으로 넣는다
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "defect-hmi",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  // *.workers.dev 주소와 미리 보기 주소는 열지 않는다 — Access 앱은 hmi.hypefree.net에만 걸려 있어, 열면 토큰을 든 Worker가 그대로 드러난다
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hmi.hypefree.net", "custom_domain": true }],
  "assets": { "directory": "./site", "binding": "ASSETS" },
  // 터널 주소 (Cloudflare Tunnel → 장비망 안 cloudflared → 메인 서버 http://10.108.108.98:5080)
  "vars": { "ORIGIN": "https://hmi-origin.hypefree.net" }
}
