# wrangler dev(이 PC에서 시험)용 값 — 이 파일을 .dev.vars로 복사해서 쓴다. .dev.vars는 저장소에 올리지 않는다
# 터널 대신 시험용 XML 서버에 붙는다: python hmi-web-mockup/tests/xml-server.py 5080 --simulation
ORIGIN=http://127.0.0.1:5080
CF_ACCESS_CLIENT_ID=local-test
CF_ACCESS_CLIENT_SECRET=local-test
# 로그인(원점 잡기만) — 이 PC 시험용 비밀번호와 쿠키 서명 키. 실제 값은 set-password.py로 Worker 비밀값에 넣는다
HMI_PASSWORD=local-test-password
SESSION_KEY=local-test-session-key
