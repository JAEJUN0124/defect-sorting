# Claude Code 개인 설정(권한 허용 목록 등)은 올리지 않는다
.claude/settings.local.json

# React 조작 화면 (hmi-web-mockup/react): 받은 패키지와 빌드 결과는 올리지 않는다
hmi-web-mockup/react/node_modules/
hmi-web-mockup/react/dist/

# 밖에서 여는 HMI (hmi-web-mockup/cloudflare): 받은 패키지, 만든 화면 파일, wrangler 작업 폴더, 이 PC 시험용 값
hmi-web-mockup/cloudflare/node_modules/
hmi-web-mockup/cloudflare/site/
hmi-web-mockup/cloudflare/.wrangler/
hmi-web-mockup/cloudflare/.dev.vars

# 파이썬 도구를 불러 쓸 때 생기는 캐시
__pycache__/

# 홍보 영상 (promo): 받은 패키지, 확인용 정지 화면·시험 영상, 그림만 담은 중간 영상, 다시 만들 수 있는 소리 파일
promo/node_modules/
promo/out/*/stills/
promo/out/*/test-*
promo/out/*/.video-*
promo/out/*/*.wav
# v1 · v2 결과 영상은 올리지 않는다 (최종은 v3). 필요하면 node promo/render.mjs --v v1 로 다시 만든다
promo/out/v1/
promo/out/v2/
